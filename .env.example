APP_NAME=shelfcash-backend
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Legacy/health setting. Runtime task routing uses the explicit task models below.
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_NEW_TOKENS=1800

# Excel mapping: strict JSON Schema, reasoning disabled, auto provider routing.
OPENROUTER_MAPPING_MODEL=qwen/qwen3.5-9b
OPENROUTER_MAPPING_TIMEOUT_SECONDS=60
OPENROUTER_MAPPING_MAX_TOKENS=1800
OPENROUTER_MAPPING_TEMPERATURE=0.0
OPENROUTER_MAPPING_REASONING_ENABLED=false
OPENROUTER_MAPPING_STRUCTURED_OUTPUT=true
OPENROUTER_MAPPING_STRICT_SCHEMA=true
OPENROUTER_MAPPING_REQUIRE_PARAMETERS=true

# Decision narrative/Q&A: strict JSON Schema, reasoning disabled, auto provider routing.
OPENROUTER_NARRATIVE_MODEL=qwen/qwen3.5-9b
OPENROUTER_NARRATIVE_TIMEOUT_SECONDS=60
OPENROUTER_NARRATIVE_MAX_TOKENS=1200
OPENROUTER_NARRATIVE_TEMPERATURE=0.0
OPENROUTER_NARRATIVE_REASONING_ENABLED=false
OPENROUTER_NARRATIVE_STRUCTURED_OUTPUT=true
OPENROUTER_NARRATIVE_STRICT_SCHEMA=true
OPENROUTER_NARRATIVE_REQUIRE_PARAMETERS=true

# Overall Decision Brief: strict, grounded one-time summary after a Decision Run.
OPENROUTER_SUMMARY_MODEL=qwen/qwen3.5-9b
OPENROUTER_SUMMARY_TIMEOUT_SECONDS=60
OPENROUTER_SUMMARY_MAX_TOKENS=900
OPENROUTER_SUMMARY_TEMPERATURE=0.0
OPENROUTER_SUMMARY_REASONING_ENABLED=false
OPENROUTER_SUMMARY_STRUCTURED_OUTPUT=true
OPENROUTER_SUMMARY_STRICT_SCHEMA=true
OPENROUTER_SUMMARY_REQUIRE_PARAMETERS=true

# Strategy presentation defaults to deterministic IS-4.4 wording and does not
# make an external model call during GET /decision-runs/{id}/brief. Set
# llm_polish only to opt into the existing guarded Qwen Strategy Expression.
STRATEGY_EXPRESSION_MODE=deterministic

# Legacy compatibility setting; narrative calls use OPENROUTER_NARRATIVE_MAX_TOKENS.
DECISION_NARRATIVE_MAX_NEW_TOKENS=1200
RULE_CONFIDENCE_THRESHOLD=0.82

MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE_MB=12
MAX_TOTAL_UPLOAD_SIZE_MB=50
MAX_SHEETS_PER_FILE=30
MAX_ROWS_PER_SHEET=100000
SAMPLE_ROWS_PER_SHEET=8

UPLOAD_DIR=runtime/uploads
RESULT_DIR=runtime/results
FORECAST_ARTIFACT_ROOT=runtime/forecast_artifacts
FORECAST_DEFAULT_MODEL_VERSION=forecast-core-v0.1.0
FORECAST_HISTORY_DAYS=365
FORECAST_MAX_HORIZON=7
FORECAST_DEBUG_EXPORT=false
FORECAST_EXPORT_DIR=forecast_debug
# Phase 1: production remains the existing core; the new core is opt-in shadow only.
FORECAST_CORE_PROVIDER=existing
FORECAST_SHADOW_PROVIDER=disabled
FORECAST_SHADOW_ENABLED=false
FORECAST_SHADOW_ARTIFACT_ROOT=runtime/forecast_shadow_artifacts
DATABASE_URL=sqlite:///runtime/shelfcash.db

SHELFCASH_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
