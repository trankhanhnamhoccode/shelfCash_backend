APP_NAME=shelfcash-backend
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.5-9b
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_NEW_TOKENS=2000
DECISION_NARRATIVE_MAX_NEW_TOKENS=2000
RULE_CONFIDENCE_THRESHOLD=0.82

MAX_FILES_PER_REQUEST=10
MAX_FILE_SIZE_MB=12
MAX_TOTAL_UPLOAD_SIZE_MB=50
MAX_SHEETS_PER_FILE=30
MAX_ROWS_PER_SHEET=100000
SAMPLE_ROWS_PER_SHEET=8

UPLOAD_DIR=runtime/uploads
RESULT_DIR=runtime/results
FORECAST_ARTIFACT_ROOT=runtime/forecast_artifacts
FORECAST_DEFAULT_MODEL_VERSION=forecast-core-v0.1.0
FORECAST_HISTORY_DAYS=365
FORECAST_MAX_HORIZON=7
FORECAST_DEBUG_EXPORT=false
FORECAST_EXPORT_DIR=forecast_debug
# Phase 1: production remains the existing core; the new core is opt-in shadow only.
FORECAST_CORE_PROVIDER=existing
FORECAST_SHADOW_PROVIDER=disabled
FORECAST_SHADOW_ENABLED=false
FORECAST_SHADOW_ARTIFACT_ROOT=runtime/forecast_shadow_artifacts
DATABASE_URL=sqlite:///runtime/shelfcash.db

SHELFCASH_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
